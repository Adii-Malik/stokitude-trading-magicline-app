# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/psx_monitor

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Admin Signup Code (required to create admin accounts)

# Super Admin bootstrap (used by: npm run create-admin)
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=change-this-strong-password

# Cache Configuration (optional)

# Python Strategy Engine (separate service - powers the Trading Bot feature)
# Leave the health check off unless that service is actually running.
PYTHON_SERVICE_URL=http://localhost:5002
PYTHON_SERVICE_HEALTHCHECK=false

# Web Push. Generate once with:  npx web-push generate-vapid-keys
# These must stay stable - changing them invalidates every device already
# subscribed, silently. Leave blank to disable push entirely.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
