{
  "name": "financial-reading",
  "version": "1.0.0",
  "description": "Financial Reading - Real-time Stock Price Monitoring & Trading Signals",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "lint": "eslint backend/src frontend/src",
    "lint:errors": "eslint backend/src frontend/src --quiet",
    "lint:fix": "eslint backend/src frontend/src --fix",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "db:local": "bash deploy/refresh-local.sh"
  },
  "keywords": [
    "psx",
    "stock",
    "monitor",
    "real-time",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.9.0"
  }
}
