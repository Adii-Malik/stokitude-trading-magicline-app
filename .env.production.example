# Copy to .env.production on the server and fill in. Never commit the real file.
# The app refuses to boot in production if MONGO_URI or JWT_SECRET is missing.

NODE_ENV=production
PORT=5001

# Production Atlas cluster - a different database from development.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/psx_monitor_prod?retryWrites=true&w=majority

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API. Leave empty when this server also
# serves the frontend, which is the default setup.
ALLOWED_ORIGINS=

# Every link in every email is built from this. Unset it and mail arrives
# looking perfectly fine with every link pointing at localhost.
FRONTEND_URL=https://example.com

# Email. The first *configured* provider wins, and the order is Resend,
# SendGrid, Brevo, SMTP - so setting RESEND_API_KEY takes over from any SMTP
# settings already here, and clearing it hands them back. Check which one is
# actually chosen with:
#   docker exec -w /app/backend financial-reading node src/scripts/checkEmail.js
#
# Resend (recommended): the from address must be on a domain verified in Resend,
# or onboarding@resend.dev, which only delivers to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM_NAME=Financial Reading
EMAIL_FROM_EMAIL=

# SMTP fallback. Gmail needs an App Password, not the account password, and the
# from address has to be the authenticated account or it will be rewritten.
# Port 25 is blocked outbound on this host; 587 and 465 are open.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Python strategy engine. It joins this stack's network and publishes no port,
# so reach it by container name. Leave blank to disable.
PYTHON_SERVICE_URL=http://strategies:5000
PYTHON_SERVICE_HEALTHCHECK=false

# Seeds the first super admin via: npm run create-admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Web Push. Generate once with:  npx web-push generate-vapid-keys
# These must stay stable - changing them invalidates every device already
# subscribed, silently. Leave blank to disable push entirely.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
