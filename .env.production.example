# Copy to .env.production on the server and fill in. Never commit the real file.
# The app refuses to boot in production if MONGO_URI, JWT_SECRET or
# ADMIN_SIGNUP_CODE are missing.

NODE_ENV=production
PORT=5001

# Production Atlas cluster - a different database from development.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/psx_monitor_prod?retryWrites=true&w=majority

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Anyone holding this can create an admin account. Generate it, don't choose it.
ADMIN_SIGNUP_CODE=

# Browser origins allowed to call the API. Leave empty when this server also
# serves the frontend, which is the default setup.
ALLOWED_ORIGINS=

# Used in outgoing email links.
FRONTEND_URL=https://example.com

# Email (optional - leave blank to disable sending)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Financial Reading
EMAIL_FROM_EMAIL=

# Python strategy engine, if deployed. Leave blank to disable.
PYTHON_SERVICE_URL=
PYTHON_SERVICE_HEALTHCHECK=false

# Seeds the first super admin via: npm run create-admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
